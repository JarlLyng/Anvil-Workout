// Secrets.xcconfig.example
// Copy this to Secrets.xcconfig and fill in your values.
// Secrets.xcconfig is gitignored and should never be committed.

// NB: brug $()/  i stedet for // i URL'en — xcconfig tolker // som kommentar.
// Eksempel: https:/$()/abc123@o123.ingest.sentry.io/456
SENTRY_DSN = https:/$()/YOUR_SENTRY_DSN_HERE

// Valgfrit — til automatisk dSYM-upload til Sentry ved Archive (Release):
// Opret auth token: Sentry → Settings → Auth Tokens (scopes: project:releases, project:write)
// SENTRY_AUTH_TOKEN = sntrys_...
// SENTRY_ORG = dit-org-slug
// SENTRY_PROJECT = iron-workout-ios
